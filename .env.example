# Database URL — PostgreSQL connection string.
#
# RAILWAY (production):
#   1. Add a PostgreSQL service in Railway (New → Database → PostgreSQL)
#   2. In your Cliperpro service → Variables → New Variable
#   3. Name: DATABASE_URL  Value: Reference Variable → Postgres.DATABASE_URL
#
# LOCAL DEV:
#   - Option A (easiest): use your Railway PostgreSQL's PUBLIC connection string
#     (Postgres service → Connect → Public URL). Paste it below.
#   - Option B: run PostgreSQL locally (e.g. via Docker) and use:
#       postgresql://user:password@localhost:5432/cliperpro
#
DATABASE_URL="postgresql://user:password@localhost:5432/cliperpro"

# OpenAI API key (optional here — can also be set in the app's Settings UI)
OPENAI_API_KEY=""

# OpenAI model override (optional). Defaults to gpt-4o-mini
OPENAI_MODEL="gpt-4o-mini"
