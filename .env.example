# Database (SQLite). On Railway, point this at a persistent volume, e.g. file:/data/app.db
DATABASE_URL="file:./db/custom.db"

# OpenAI API key (optional here — can also be set in the app's Settings UI)
OPENAI_API_KEY=""

# OpenAI model override (optional). Defaults to gpt-4o-mini
OPENAI_MODEL="gpt-4o-mini"
